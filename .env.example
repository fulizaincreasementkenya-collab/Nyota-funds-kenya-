
# Copy this file to .env and fill in your values
# Never commit .env to version control!

FINAPI_API_KEY=your_finapi_live_key_here
FINAPI_BASE_URL=https://api.finapi.co.ke

WEBHOOK_SECRET=generate_a_random_secure_string_here

PORT=10000
NODE_ENV=production

# For Render, use the URL without https://
CALLBACK_URL=https://your-app-name.onrender.com/callback


ALLOWED_ORIGINS=https://your-app-name.onrender.com

